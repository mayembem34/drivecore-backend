# Copy to /opt/drivecore/infrastructure/backup.env with mode 600.
# Use an off-server repository with a separate restricted credential.
RESTIC_REPOSITORY=s3:https://YOUR-ENDPOINT/YOUR-BUCKET/drivecore
RESTIC_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_DEFAULT_REGION=REPLACE_ME
